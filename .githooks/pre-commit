#!/bin/sh

# --- Branch protection ---
branch="$(git rev-parse --abbrev-ref HEAD)"
if [ "$branch" = "main" ] || [ "$branch" = "release/v1" ]; then
  echo "ERROR: Direct commits to '$branch' are not allowed."
  echo "Create a feature branch and open a pull request instead."
  exit 1
fi

# --- Repo guard scripts ---
if ! scripts/check-sync-guards.sh; then
  echo "ERROR: sync guard checks failed."
  exit 1
fi

if ! scripts/check-c2-guards.sh; then
  echo "ERROR: C2 guard checks failed."
  exit 1
fi

# --- Lint staged shell files ---
STAGED_SHELL=$(git diff --cached --name-only --diff-filter=ACMR -- '*.sh')
if [ -n "$STAGED_SHELL" ]; then
  if ! command -v shellcheck >/dev/null 2>&1; then
    echo "WARNING: shellcheck is unavailable; run: brew install shellcheck. Skipping staged shell lint."
  else
    while IFS= read -r file; do
      if ! shellcheck "$file"; then
        echo "ERROR: shellcheck failed on $file"
        exit 1
      fi
    done <<EOF
$STAGED_SHELL
EOF
  fi
fi

# --- Lint staged Ruby files ---
STAGED_RUBY=$(git diff --cached --name-only --diff-filter=ACMR -- '*.rb' 'fastlane/Fastfile')
if [ -n "$STAGED_RUBY" ]; then
  if ! command -v bundle >/dev/null 2>&1 || ! bundle exec rubocop --version >/dev/null 2>&1; then
    echo "WARNING: RuboCop is unavailable; run: bundle install. Skipping staged Ruby lint."
  else
    while IFS= read -r file; do
      if ! bundle exec rubocop "$file"; then
        echo "ERROR: RuboCop failed on $file"
        exit 1
      fi
    done <<EOF
$STAGED_RUBY
EOF
  fi
fi

# --- Auto-format staged Swift files ---
STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
if [ -n "$STAGED_SWIFT" ]; then
  if ! command -v swift-format >/dev/null 2>&1; then
    echo "ERROR: swift-format is not installed."
    echo "Install it with: brew install swift-format"
    exit 1
  fi
  while IFS= read -r file; do
    if ! swift-format --in-place "$file"; then
      echo "WARNING: swift-format failed on $file"
    fi
    git add "$file"
  done <<EOF
$STAGED_SWIFT
EOF
fi

# --- Reject raw @Query usage (use @SafeQuery instead) ---
if [ -n "$STAGED_SWIFT" ]; then
  RAW_QUERY_FILES=""
  while IFS= read -r file; do
    case "$file" in
      */SafeQuery.swift) continue ;;
    esac
    if grep -q '^[^/]*@Query' "$file" 2>/dev/null; then
      RAW_QUERY_FILES="$RAW_QUERY_FILES
  $file"
    fi
  done <<QUERYEOF
$STAGED_SWIFT
QUERYEOF
  if [ -n "$RAW_QUERY_FILES" ]; then
    echo "ERROR: Raw @Query usage detected. Use @SafeQuery instead."
    echo "See Foqos/Utils/SafeQuery.swift"
    echo ""
    echo "Files:$RAW_QUERY_FILES"
    exit 1
  fi
fi
